Options -Indexes

# Route all requests through index.php (except actual files like save.php, bookmarks.json, etc.)
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^$ index.php [L]

# Block direct access to sensitive files
<FilesMatch "^(bookmarks\.json|\.secret|server\.js)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Never cache the data API — always serve fresh from MySQL
<FilesMatch "data\.php$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</FilesMatch>
